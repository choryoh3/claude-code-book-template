# 環境変数の見本。コピーして .env を作って使う（.env は Git の管理外。秘密の値は .env にだけ書く）
#   Copy-Item .env.example .env
# .env が無くても、開発用の既定値（この見本と同じ値）で動く。

# ---------------------------------------------------------------- DB
DATABASE_URL=postgresql://postgres:test999@localhost:5432/xclone
# テスト用（API テストは xclone_test、E2E は xclone_e2e を自動で作り直す。開発用の DB とは必ず分ける）
TEST_DATABASE_URL=postgresql://postgres:test999@localhost:5432/xclone_test
E2E_DATABASE_URL=postgresql://postgres:test999@localhost:5432/xclone_e2e

# ---------------------------------------------------------------- 認証（docs/adr/0004）
# access token（JWT）の署名用。本番では必ず 32 文字以上のランダムな値にする（開発用の値のままだと起動しない）
# ※ refresh token は JWT ではなく乱数なので、refresh 用のシークレットは不要
JWT_ACCESS_SECRET=change-me-access-secret-for-dev
# 管理者用（Phase 5）。一般ユーザー用とは必ず別の値にする
ADMIN_JWT_ACCESS_SECRET=change-me-admin-access-secret-for-dev

# ---------------------------------------------------------------- user/server（一般ユーザー向け API）
USER_SERVER_PORT=3000
# 画面の URL（CORS と Socket.IO で許可する接続元）
USER_CLIENT_ORIGIN=http://localhost:5173
# アップロードした画像の URL の先頭。これ以外の画像 URL は保存させない
PUBLIC_BASE_URL=http://localhost:3000
# 回数制限（1 分あたり・IP ごと）
AUTH_RATE_LIMIT_PER_MINUTE=20
MEDIA_RATE_LIMIT_PER_MINUTE=30
# ログの細かさ（fatal / error / warn / info / debug / trace / silent）。ログは logs/user-server.log
LOG_LEVEL=info

# ---------------------------------------------------------------- admin（Phase 5〜6）
ADMIN_SERVER_PORT=3001
ADMIN_CLIENT_ORIGIN=http://localhost:5174

# ---------------------------------------------------------------- Claude Code の MCP
# GitHub MCP 用。.env ではなく、シェルの環境変数として設定する（Claude Code は .env を読まない）
# GITHUB_PERSONAL_ACCESS_TOKEN=
