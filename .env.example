# コピーして .env を作成して使う(.env は Git 管理外)
DATABASE_URL=postgresql://postgres:test999@localhost:5432/xclone

# JWT(本番では必ず十分長いランダム値に変更)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ADMIN_JWT_ACCESS_SECRET=change-me-admin-access
ADMIN_JWT_REFRESH_SECRET=change-me-admin-refresh

USER_SERVER_PORT=3000
ADMIN_SERVER_PORT=3001
USER_CLIENT_ORIGIN=http://localhost:5173
ADMIN_CLIENT_ORIGIN=http://localhost:5174

# GitHub MCP 用(シェル環境変数として設定する。.env は Claude Code から読まれない)
# GITHUB_PERSONAL_ACCESS_TOKEN=
